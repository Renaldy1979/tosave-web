# Endereços públicos (entram no bundle no build). Sem valor, valem os padrões abaixo.

# API v2 (backendToSave). Em dev local com o backend rodando: http://localhost:3334
NEXT_PUBLIC_API_URL="https://api.tosave.cloud"

# Appwrite (login e imagens)
NEXT_PUBLIC_APPWRITE_ENDPOINT="https://tosave-appwrite.8m5sgi.easypanel.host/v1"
NEXT_PUBLIC_APPWRITE_PROJECT_ID="6aa1d3ab0039a9a9a8c4"

# Link "Ver site" do painel / "Voltar ao site" do auth
NEXT_PUBLIC_APP_URL="https://app.tosave.cloud"
NEXT_PUBLIC_SITE_URL="https://tosave.cloud"

# Variável de runtime (SEM NEXT_PUBLIC_, nunca vai para o navegador nem para o
# build): enviada como header `X-Site-Key` nas chamadas do servidor a
# `/v2/public/*` (SSR, generateMetadata, sitemap), para isentar o site do
# limite por IP da API. Pedir o valor ao Alicerce/backendToSave.
PUBLIC_SITE_KEY=""
